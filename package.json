{
  "name": "hello-world-app",
  "version": "1.0.0",
  "description": "Beginner CI/CD example: Express API + static build, served together.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node src/server.js",
    "test": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:all": "jest",
    "lint": "eslint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
